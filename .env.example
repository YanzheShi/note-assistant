# ============================================================
# Obsidian RAG - 环境变量示例
# 用法：复制为 .env 后填写真实值即可运行
#   cp .env.example .env
#
# 本文件只保留项目【实际用到】的配置。
# 已从原 .env 中剔除的无效残留：DEEPSEEK_*、AGNES_*、
# SENSENOVA_*、OTHER_CONFIG，以及名字写错、从未被读取的
# OLLAMA_HOST（代码读的是 ollama_base_url，见下方第 3 节）。
# 其余 config.py 中带默认值的参数未列出，按需覆盖即可。
# ============================================================

# ---------- 1. 笔记库路径（必填） ----------
# Obsidian vault 根目录，索引与问答都基于它
VAULT_PATH=D:\Note\test

# 索引忽略的目录名（JSON 数组，大小写不敏感，vault 内任意层级命中即跳过）。
# 用于排除与笔记无关却会污染检索的目录：模板目录、纯附件目录、vault 里 clone 的代码仓库。
# 作用于全量索引 / 增量索引 / 附件索引 / 自动监听（AUTOINDEX_*）四处，共用同一份规则。
# .obsidian、.git、.trash 等隐藏目录无需配置，代码里始终忽略。
# 改这里需重启后端，并跑一次全量 /reindex 才会清掉已入库的旧 chunks。
# INDEX_IGNORE_DIRS=["templates", "附件", "node_modules"]

# ---------- 2. 生成 / Agent 用 LLM（必填，无默认值） ----------
# 统一走 OpenAI 兼容网关，由 llm/client.py::get_llm() 读取
AGENT_API_KEY=your-agent-api-key-here
AGENT_BASE_URL=https://token.sensenova.cn/v1
AGENT_MODEL=deepseek-v4-flash

# ---------- 3. 本地 Embedding（Ollama，可选） ----------
# ⚠️ 注意：真实变量名是 OLLAMA_BASE_URL（原 .env 误写为 OLLAMA_HOST，已废弃）。
#    不填则用默认值 http://localhost:11434，需本机已运行 Ollama 并拉取 bge-m3。
# OLLAMA_BASE_URL=http://localhost:11434

# ---------- 4. 切分策略（可选） ----------
# v1=扁平递归 / v2=层级标题 / v2b=父子双存（推荐，子块检索、父块回退整节）
CHUNKING_STRATEGY=v2b

# ---------- 5. 评测（RAGAS，可选） ----------
RAGAS_BASE_URL=https://token.sensenova.cn/v1
RAGAS_API_KEY=your-ragas-api-key-here
RAGAS_LLM_MODEL=sensenova-6.7-flash-lite

# ---------- 6. 链路追踪（LangSmith，可选） ----------
LANGSMITH_TRACING_ENABLED=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# ---------- 7. Agent 行为开关（可选） ----------
# 自动图扩展：每轮检索后沿 [[wikilinks]] 扩展关联笔记，默认关闭
AGENT_GRAPH_EXPAND_ENABLED=true
AGENT_GRAPH_EXPAND_HOP=2

# ---------- 8. 澄清 / 反问（可选） ----------
# 澄清总开关（关闭时所有澄清分支短路，与改造前等价）
AGENT_CLARIFY_ENABLED=true
# 消解置信度阈值：低于该值才允许进入澄清候选
AGENT_CLARIFY_CONFIDENCE_THRESHOLD=0.8

# ---------- 9. 凝练 / 长程摘要 专属 LLM（可选） ----------
# 默认全部留空 → 凝练（消指代改写）与长程摘要（滚动压缩）都复用上方第 2 节
# 的 AGENT_* 主文本通道，与改造前完全等价（零回归）。
# 想省钱/提速：把这两类能力丢给更便宜/更快的模型，主模型只管答案生成。
# 规则：只填 *_MODEL 即可（网关/密钥复用 AGENT_*）；要独立网关/密钥再补 *_BASE_URL / *_API_KEY。
# AGENT_CONDENSE_MODEL=some-cheap-flash
# AGENT_CONDENSE_BASE_URL=
# AGENT_CONDENSE_API_KEY=
# AGENT_SUMMARIZE_MODEL=some-cheap-flash
# AGENT_SUMMARIZE_BASE_URL=
# AGENT_SUMMARIZE_API_KEY=
